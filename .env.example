# Copia este archivo a `.env.local` y rellena con tus claves reales.
# Ninguna de estas claves es secreta-de-servidor: van embebidas en el bundle
# del cliente. Restringe la YouTube Data API por HTTP Referer en Google Cloud
# y protege Firestore con las reglas de seguridad (firestore.rules).

# YouTube Data API v3 (búsqueda de videoId) — Google Cloud console
VITE_YOUTUBE_API_KEY=

# Last.fm API (metadatos + similitud) — https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=

# Firebase (Firestore + Auth anónima) — Project settings → tu app web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
