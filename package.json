{
  "name": "tuafm",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "TuaFM — reproductor de música web con memoria histórica de charts",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "@vueuse/rxjs": "^14.3.0",
    "dexie": "^4.4.0",
    "nanoid": "^5.0.0",
    "papaparse": "^5.4.0",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.2.0",
    "rxjs": "^7.8.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/papaparse": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.4"
  }
}
