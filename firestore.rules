rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Caché de metadatos enriquecidos: lectura pública, escritura/actualización
    // solo con auth (anónima incluida). Se permite update para poder parchear
    // el youtubeVideoId cuando el primer enriquecimiento lo dejó null y para
    // refrescar entradas expiradas (TTL gestionado en cliente). delete prohibido.
    // Trade-off conocido: un cliente con auth podría sobrescribir una entrada;
    // aceptable para el alcance personal de la app (ver dudas.md → App Check).
    match /track_cache/{cacheKey} {
      allow read:           if true;
      allow create, update: if request.auth != null;
      allow delete:         if false;
    }

    // Catálogo de fuentes de charts: solo lectura pública.
    // Escritura solo desde scripts con Admin SDK (que ignora estas reglas).
    match /chart_registry/{chartId} {
      allow read:  if true;
      allow write: if false;
    }

    // Datos de charts por periodo: solo lectura pública.
    match /chart_periods/{periodId} {
      allow read:  if true;
      allow write: if false;
    }
  }
}
